extends base 



block content

	main
	
		section.customizationPage
		
			.container
			
				.customizationPage__grid
				
					.customizationPage__grid--image--box
						.customizationPage__grid--image
							img(src="/img/other_imgs/side-img-1.jpeg", class='customizationPage--img', alt="")
						
		
					.customizationPage__grid--text--box
					
						.customizationPage--heading-box

							h1.customizationPage--heading Custom Tailoring
							p.customizationPage__tagline Create Your Signature Barong Tagalog or Filipiniana
							.customizationPage--paragraph-box
								p.customizationPage__text Celebrate Filipino heritage through garments crafted uniquely for you. Our customization experience allows you to design a Barong Tagalog or Filipiniana that reflects your personal style while preserving the elegance of traditional craftsmanship.
								p.customizationPage__text Select from premium fabrics such as piña, jusi, organza, jusilin, and silk blends, choose sleeve and collar styles, refine embroidery motifs, and tailor the fit to your exact measurements. Whether for weddings, formal events, cultural celebrations, or professional wear, each piece is carefully made to embody both identity and sophistication.
								
								p.customizationPage__text Our process combines heritage techniques with modern precision, ensuring every garment achieves exceptional detail, comfort, and structure. From subtle minimalist embroidery to elaborate hand-finished patterns, you control every design variable.
							
							ul.customizationPage__benefits
								li.customizationPage__benefit
									img(src="/img/icons/check-gold.svg", alt="")
									p Fabric type and texture
								li.customizationPage__benefit
									img(src="/img/icons/check-gold.svg", alt="")
									p Embroidery pattern and placement
								li.customizationPage__benefit
									img(src="/img/icons/check-gold.svg", alt="")
									p Collar and sleeve configuration
								li.customizationPage__benefit
									img(src="/img/icons/check-gold.svg", alt="")
									p Button style and placket length (full or half button)
								li.customizationPage__benefit
									img(src="/img/icons/check-gold.svg", alt="")
									p Garment color palette (including champagne, ivory, mocha tones)
								li.customizationPage__benefit
									img(src="/img/icons/check-gold.svg", alt="")
									p Exact body measurements for tailored fit
												
							p.customizationPage__text Begin your design journey and create a garment that expresses tradition — refined for the present.  
							.customizationPage__actions
								a.customizationPage__cta(href='/static/contact-custom') Enquire Now
							