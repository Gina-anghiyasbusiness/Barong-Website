extends base 



block content

	main
	
		section.customizationPage
		
			.container
			
				.customizationPage__grid
				
					.customizationPage__grid--image--box
						.customizationPage__grid--image
							img(src="/img/other_imgs/side-img-1.jpeg", class='customizationPage--img', alt="")
						
		
					.customizationPage__grid--text--box
					
						.customizationPage--heading-box

							h1.customizationPage--heading Custom Tailoring
							p.customizationPage__tagline Timeless Filipino elegance, designed just for you
							p.customizationPage__text Stand out in a Barong or Filipiniana made just for you. Our custom-tailored pieces are crafted with precision, tradition, and your personal style in mind.
							
							ul.customizationPage__benefits
								li.customizationPage__benefit
									img(src="/img/icons/check-gold.svg", alt="")
									p Made to measure
								li.customizationPage__benefit
									img(src="/img/icons/check-gold.svg", alt="")
									p Choice of fabric and design
								li.customizationPage__benefit
									img(src="/img/icons/check-gold.svg", alt="")
									p Perfect fit
												
							p.customizationPage__text Book your custom fitting today. Submit an enquiry and we’ll get back to you with available options.  
							.customizationPage__actions
								a.customizationPage__cta(href='/static/contact-custom') Enquire Now
							