extends base 



block content

	main
	
		section.customizationPage
		
			.container
			
				.customizationPage__grid
				
					.customizationPage__grid--image--box
						.customizationPage__grid--image
							img(src="/img/other_imgs/side-img-1.jpeg", class='customizationPage--img', alt="Custom Barong Tagalog and Filipiniana tailoring")
						
		
					.customizationPage__grid--text--box
					
						.customizationPage--heading-box

							h1.customizationPage--heading Custom Barong Tagalog & Filipiniana
							p.customizationPage__tagline Made-to-measure Filipino formalwear for weddings and special occasions.
							.customizationPage--paragraph-box
							
								p.customizationPage__text Celebrate Filipino heritage with a custom Barong Tagalog or Filipiniana dress crafted for your occasion, style, and measurements. Choose from premium fabrics such as piña, jusi, organza, jusilin, and silk blends, with options for sleeve styles, collars, embroidery motifs, and tailored fit.

								p.customizationPage__text Whether for weddings, graduations, oath-taking ceremonies, cultural celebrations, or formal events, each made-to-measure garment combines traditional Filipino craftsmanship with modern elegance. From minimalist embroidery to detailed hand-finished patterns, your Barong Tagalog or Filipiniana is made to reflect identity, comfort, and sophistication.
								
							
							ul.customizationPage__benefits
								li.customizationPage__benefit
									img(src="/img/icons/check-gold.svg", alt="")
									p Premium fabrics including piña, jusi, organza and silk blends

								li.customizationPage__benefit
									img(src="/img/icons/check-gold.svg", alt="")
									p Custom embroidery pattern and placement

								li.customizationPage__benefit
									img(src="/img/icons/check-gold.svg", alt="")
									p Collar, sleeve and placket styling

								li.customizationPage__benefit
									img(src="/img/icons/check-gold.svg", alt="")
									p Colour options for Barong Tagalog and Filipiniana

								li.customizationPage__benefit
									img(src="/img/icons/check-gold.svg", alt="")
									p Made-to-measure sizing for a tailored fit
												
 
							p.customizationPage__text Start your custom Barong Tagalog or Filipiniana dress journey and create a garment that expresses tradition — refined for the present.
							.customizationPage__actions
								a.customizationPage__cta(href='/static/contact-custom') Enquire Now
							