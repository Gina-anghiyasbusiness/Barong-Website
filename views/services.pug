extends base 



block content

	main
	
		section.servicesPage
			.container
				.salesPage__grid
				
					.salesPage__grid--image--box
					
						.salesPage__grid--image
							img(src="/img/other_imgs/side-img-4.webp", class='salesPage--img', loading="eager", fetchpriority="high", decoding="async" , alt="Ang Hiyas Filipino clothing services")
		
					.salesPage__grid--text--box
						.servicesPage--heading-box

							h1.servicesPage--heading Custom Barong Tagalog & Filipiniana Services
							p.servicesPage__tagline Filipino formal wear for weddings, cultural events and special occasions

							p.servicesPage__text Ang Hiyas specialises in custom Barong Tagalog and Filipiniana dress services, with rental options also available for weddings, cultural celebrations, graduations, oath-taking ceremonies and formal events.

							p.servicesPage__text Whether you are looking for Filipino wedding attire, a made-to-measure garment, or an elegant outfit to rent for a special occasion, our services are designed to help you feel confident, comfortable and connected to tradition.

							ul.servicesPage__benefits
								li.servicesPage__benefit
									img(src="/img/icons/check-gold.svg", alt="")
									p Custom tailoring for Barong Tagalog and Filipiniana
								li.servicesPage__benefit
									img(src="/img/icons/check-gold.svg", alt="")
									p Made-to-measure Filipino formal wear for weddings and special events
								li.servicesPage__benefit
									img(src="/img/icons/check-gold.svg", alt="")
									p Rental options for formal and cultural occasions
								
							.servicesPage__actions
								a.servicesPage__cta(href='/static/custom') Custom Barong & Filipiniana
								a.servicesPage__cta(href='/static/rentals') Barong & Filipiniana Rentals
								