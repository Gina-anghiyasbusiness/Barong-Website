extends base 



block content

	main
	
		section.servicesPage
			.container
				.salesPage__grid
				
					.salesPage__grid--image--box
					
						.salesPage__grid--image
							img(src="/img/other_imgs/side-img-4.jpeg", class='salesPage--img', alt="")
		
					.servicesPage--heading-box

						h1.servicesPage--heading Services
						p.servicesPage__tagline Timeless Filipino Elegance for Every Occasion
						p.servicesPage__text Whether you need a custom-tailored piece or an elegant outfit for a special occasion, Ang Hiyas offers services designed to help you look your best with confidence and style.

						ul.servicesPage__benefits
							li.servicesPage__benefit Custom tailoring for a perfect fit
							li.servicesPage__benefit Rental options for weddings and formal occasions
							li.servicesPage__benefit Traditional elegance with modern style
							
						.servicesPage__actions
							a.servicesPage__cta(href='/static/custom') Custom Tailoring
							a.servicesPage__cta(href='/static/rentals') Rentals
							