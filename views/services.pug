extends base 



block content

	main
	
		section.servicesPage
			.container
				.salesPage__grid
				
					.salesPage__grid--image--box
					
						.salesPage__grid--image
							img(src="/img/other_imgs/side-img-4.jpeg", class='salesPage--img', alt="")
		
					.salesPage__grid--text--box
						.servicesPage--heading-box

							//- h1.servicesPage--heading Services
							//- p.servicesPage__tagline Timeless Filipino Elegance for Every Occasion
							//- p.servicesPage__text Whether you need a custom-tailored piece or an elegant outfit for a special occasion, Ang Hiyas offers services designed to help you look your best with confidence and style.
							h1.servicesPage--heading Barong Tagalog & Filipiniana Services
							p.servicesPage__tagline Filipino formal wear for weddings, events and special occasions

							p.servicesPage__text Ang Hiyas offers custom Barong Tagalog, Filipiniana dress services, ready-made styles and rental options for weddings, cultural celebrations, graduations, oath taking ceremonies and formal events.

							p.servicesPage__text Whether you are looking for Filipino wedding attire, a made-to-measure garment, or an elegant outfit to rent for a special occasion, our services are designed to help you feel confident, comfortable and connected to tradition.

							ul.servicesPage__benefits
								li.servicesPage__benefit
									img(src="/img/icons/check-gold.svg", alt="")
									p Custom tailoring for a perfect fit
								li.servicesPage__benefit
									img(src="/img/icons/check-gold.svg", alt="")
									p Rental options for weddings and formal occasions
								li.servicesPage__benefit
									img(src="/img/icons/check-gold.svg", alt="")
									p Traditional elegance with modern style
								
							.servicesPage__actions
								a.servicesPage__cta(href='/static/custom') Custom Tailoring
								a.servicesPage__cta(href='/static/rentals') Rentals
								