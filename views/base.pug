doctype html 

html 
	head
	
		//-- Google Tag Manager (early load)
		
		
		meta(charset='UTF-8')
		meta(name='viewport' content='width=device-width, initial-scale=1.0')
		meta(name='description' content=pageDescription || 'filipino barong filipiniana clothing')
				
		
		if noIndex
			meta(name="robots" content="noindex, nofollow")
		else
			meta(name="robots" content="index, follow")
			link(rel="canonical" href=canonicalUrl)
		
		//-- Open Graph / Social Share

		- const defaultOgTitle = pageTitle || 'Barong Tagalog & Filipiniana Australia | Ang Hiyas'
		- const defaultOgDescription = pageDescription || 'Barong Tagalog, Filipiniana, custom tailoring, rentals, and Filipino formalwear across Australia.'
		- const defaultOgImage = `${process.env.CANONICAL_URL}img/seo/ang-hiyas-og-default.jpg`

		meta(property="og:type" content=ogType || "website")
		meta(property="og:site_name" content="Ang Hiyas")
		meta(property="og:url" content=canonicalUrl || process.env.CANONICAL_URL)
		meta(property="og:title" content=ogTitle || defaultOgTitle)
		meta(property="og:description" content=ogDescription || defaultOgDescription)
		meta(property="og:image" content=ogImage || defaultOgImage)
		meta(property="og:image:width" content="1200")
		meta(property="og:image:height" content="630")
		meta(property="og:image:type" content="image/jpeg")

		//-- Twitter / X Card

		meta(name="twitter:card" content="summary_large_image")
		meta(name="twitter:title" content=ogTitle || defaultOgTitle)
		meta(name="twitter:description" content=ogDescription || defaultOgDescription)
		meta(name="twitter:image" content=ogImage || defaultOgImage)
		
		
		link(rel='stylesheet', href='/css/style.css?v=1.2')
		
		
		//-- Preconnects (speed up external resources)
		
		
		
		
		//-- Preloads (critical assets)		
		
		if currentPage === 'home'
			link(rel="preload" as="image" href="/img/other_imgs/new_hero.webp" type="image/webp" fetchpriority="high")
			link(rel="preload" as="font" href="/img/fonts/cairo/Cairo-Bold.woff2" type="font/woff2" crossorigin)
			link(rel="preload" as="font" href="/img/fonts/cairo/Cairo-SemiBold.woff2" type="font/woff2" crossorigin)
			link(rel="preload" as="font" href="/img/fonts/rubik/Rubik-Regular.woff2" type="font/woff2" crossorigin)
		if currentPage === 'product' && productPreloadImage
			link(rel="preload" as="image" href=productPreloadImage fetchpriority="high")
			
		
			
		link(rel='icon' type='image/png' sizes='32x32' href='/img/favicons/defaultfavicon.png')
		
		title= pageTitle || 'Ang Hiyas | Filipino Clothing Australia'
		
		if !noIndex
			script(type="application/ld+json").
				{
					"@context": "https://schema.org",
					"@type": "ClothingStore",
					"@id": "https://www.anghiyas.com.au/#business",
					"name": "Ang Hiyas",
					"description": "Ang Hiyas offers Barong Tagalog, Filipiniana, custom tailoring, rentals, and Filipino formal wear across Queensland and Australia.",
					"url": "https://www.anghiyas.com.au/",
					"telephone": "+61403542521",
					"email": "info@anghiyas.com.au",
					"image": "https://www.anghiyas.com.au/img/seo/ang-hiyas-og-default.jpg",
					"logo": "https://www.anghiyas.com.au/img/logo/default-logo.png",
					"priceRange": "$$",
					"address": {
						"@type": "PostalAddress",
						"addressLocality": "Logan",
						"addressRegion": "Queensland",
						"addressCountry": "AU"
					},
					"areaServed": [
						 {
					    "@type": "City",
					    "name": "Logan"
					  },
					  {
					    "@type": "City",
					    "name": "Brisbane"
					  },
						{
							"@type": "AdministrativeArea",
							"name": "Queensland"
						},
						{
							"@type": "Country",
							"name": "Australia"
						}
					],
					"openingHoursSpecification": [
						{
							"@type": "OpeningHoursSpecification",
							"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
							"opens": "09:00",
							"closes": "17:00"
						},
						{
							"@type": "OpeningHoursSpecification",
							"dayOfWeek": "Saturday",
							"opens": "10:00",
							"closes": "16:00"
						},
						{
							"@type": "OpeningHoursSpecification",
							"dayOfWeek": "Sunday",
							"opens": "13:00",
							"closes": "16:00"
						}
					],
					"hasOfferCatalog": {
						"@type": "OfferCatalog",
						"name": "Ang Hiyas services",
						"itemListElement": [
							{
								"@type": "Offer",
								"itemOffered": {
									"@type": "Service",
									"name": "Custom Barong Tagalog",
									"serviceType": "Custom tailoring"
								}
							},
							{
								"@type": "Offer",
								"itemOffered": {
									"@type": "Service",
									"name": "Custom Filipiniana",
									"serviceType": "Custom tailoring"
								}
							},
							{
								"@type": "Offer",
								"itemOffered": {
									"@type": "Service",
									"name": "Barong Tagalog and Filipiniana rentals",
									"serviceType": "Clothing rental"
								}
							},
							{
								"@type": "Offer",
								"itemOffered": {
									"@type": "Service",
									"name": "Filipino formal wear sales",
									"serviceType": "Retail clothing"
								}
							}
						]
					}
				}
			if productSchema
				script(type="application/ld+json")!= JSON.stringify(productSchema).replace(/</g, '\\u003c')	

	body
		// Header
		include _header


		// Content
		.tailwind_stretch
			block content
				h1 Placeholder in Base

		// Footer
		include _footer

		block paymentScripts
		

		script(defer src='/js/bundle.js')
		

		
