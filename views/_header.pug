header.main_header

	.header
	
		.header__logo--box

			a(href="/") 
				img(src='/img/logo/default-logo.png', alt='Ang Hiyas', class='header__logo' fetchpriority="high")
		
		.header__nav--box
		
			nav.header__nav 
				ul.header__nav--list 
					li.header__nav--item.dropdown 
						a(href='/static/sales' class='header__nav--link--dropdown') Shop
						.dropdown-menu
							a(href="/barong-list") Barong and Filipiniana 
							//- a(href="/shoe-list") Shoes
							a(href="/bag-list") Bags
							a(href="/accessories-list") Accessories 
					li.header__nav--item.dropdown  
						a(href='/static/services' class='header__nav--link--dropdown') Services
						.dropdown-menu
							a(href="/static/custom") Customization 					
							a(href="/static/rentals") Rentals 
					li.header__nav--item 
						a(href='/static/about' class='header__nav--link') About
					li.header__nav--item 
						a(href='/static/contact' class='header__nav--link') Contact
				
		.header__user--settings
		
			if user
				.header__user
							
					.header__user--icons 
						a(href=`/my-account/${user.id}`).header__user--link.user__account--link
							i(data-lucide='user-round')
							
						a(href=`/my-account/${user.id}?show=my-account-wishlist`).header__user--link.user__wishlist--link
							i(data-lucide='star')
							if user.wishlist.length > 0
								span.user__wishlist--span #{user.wishlist.length}
							else 
								span.user__wishlist 
							
						a(href=`/my-account/${user.id}?show=my-account-cart`).header__user--link.user__cart--link 
							i(data-lucide='shopping-cart')
							if user.cart.length > 0
								span.user__cart--span #{user.cart.length}
							else 
								span.user__cart 
						
					//- .header__user--button 
					//- 	a(href="/" class='header__login--link logout--btn') Logout
				
			else
				.header__user--login-button 
					a(href="/login-page" class='header__login--link login--btn') Login/Signup
			
		.header__hamburger-menu 
			button.header__mobile-menu-btn(type="button" aria-label="Open menu")
				i(data-lucide="menu")
				
	.header__mobile-overlay
		.header__mobile-overlay-top
			a(href="/")
				img(src="/img/logo/default-logo.png", alt='Ang Hiyas', class="header__mobile-logo")
			button.header__mobile-close(type="button" aria-label="Close menu")
				i(data-lucide="x")

		nav.header__mobile-nav
			.header__mobile-group
				a.header__mobile-link(href="/static/sales") Shop
				a.header__mobile-sublink(href="/barong-list") Barong and Filipiniana
				a.header__mobile-sublink(href="/bag-list") Bags
				a.header__mobile-sublink(href="/accessories-list") Accessories

			.header__mobile-group
				a.header__mobile-link(href="/static/services") Services
				a.header__mobile-sublink(href="/static/custom") Customization
				a.header__mobile-sublink(href="/static/rentals") Rentals

			a.header__mobile-link(href="/static/about") About
			a.header__mobile-link(href="/static/contact") Contact

			if user
				a.header__mobile-link(href=`/my-account/${user.id}`) My Account
				a.header__mobile-link(href=`/my-account/${user.id}?show=my-account-wishlist`) Wishlist
				a.header__mobile-link(href=`/my-account/${user.id}?show=my-account-cart`) Cart
			else
				a.header__mobile-link(href="/login-page") Login/Signup	
					
.header__banner--preview 
	.header__banner--text 
		p Website Preview — This site is currently under development
			