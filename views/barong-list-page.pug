extends base 


block content 

	main.homePage__main.container
	
		
		section.homePage-productList
			.productList--heading-box
				
				.productList_sort-box
				
					h2.homePage--sub-heading  Barongs
					form#form-product-sort.product-sort-form(action="/barong-list" method="GET") 
					
						.product-sort--row
							label(for="productSort") Sort:
							select#productSort(name="productSort") 
								option(value="newest" selected=selectedOption === 'newest') Newest 
								option(value="lowest" selected=selectedOption === 'lowest') Lowest Price 
								option(value="highest" selected=selectedOption === 'highest') Highest Price 
								option(value="alphabet" selected=selectedOption === 'alphabet') A-Z			
						

			.main_barong-list

				.barong-list__filter
				
					.barong-list__filter-gender
						.barong-list__filter--btn-box
							button#barong__filter-btn--gender.barong-list__filter-btn(type='button') Gender
						ul.barong-list--ul-gender
							li
								a(
									href=`?productSort=${selectedOption || 'newest'}&productSize=${selectedSize || ''}&color=${selectedColor || ''}&sex=male`
									class=selectedSex === 'male' ? 'active' : ''
								) Mens
							li
								a(
									href=`?productSort=${selectedOption || 'newest'}&productSize=${selectedSize || ''}&color=${selectedColor || ''}&sex=female`
									class=selectedSex === 'female' ? 'active' : ''
								) Womens
							li
								a(
									href=`?productSort=${selectedOption || 'newest'}&productSize=${selectedSize || ''}&color=${selectedColor || ''}&sex=boy`
									class=selectedSex === 'boy' ? 'active' : ''
								) Boys
								
									
								
					.barong-list__filter-color
						.barong-list__filter--btn-box
							button#barong__filter-btn--color.barong-list__filter-btn(type='button') Color					
						ul#barong-list--ul-color.barong-list--ul-color 
							each color in colorList
								li
									a(href=`?color=${color}` class=selectedColor === color ? 'active' : '') #{color.charAt(0).toUpperCase() + color.slice(1)}

				
								
					.barong-list__filter-size
						.barong-list__filter--btn-box
							button#barong__filter-btn--size.barong-list__filter-btn(type='button') Size					
						ul#barong-list--ul-size.barong-list--ul-size 
							each size in sizeList
								li 
									a(href='#') #{size}

					.barong-list__filter-clear 
						a.barong-list__clear-filters(href='/barong-list') Clear Filters

				
				.barong-page--list
					each product in productlist
						.productList__product 	
							a(href=`/barong/${product.slug}` class='productList__page--link') 
								- const category = 	product.category ? product.category.name : "";
								.productList-box--img 
									
									img(src=`/img/product_imgs/${product.imageCover}`, alt='image',width="800",height="450", class='productListPage__img' fetchpriority="high")
								.productList-box
									.productList-box--heading
										h4 #{product.name}
									.productList__group--box.muted-text
										if product.discountPrice && product.discountPrice < product.originalPrice
											p.price--old $#{product.originalPrice}
											p.price--new $#{product.discountPrice}
										else 
											p.price--single $#{product.originalPrice}
				

					
		
				
			