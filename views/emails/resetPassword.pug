extends baseEmail

block content

  main.email-wrapper

    .email-card

      .email-header
        img.email-logo(src=logoUrl, alt="Ang Hiyas logo")
        h1 Reset your password
        p.email-subtitle We received a request to reset the password for your Ang Hiyas account.

      .message-box
        p Hi #{firstname},
        p Use the button below to create a new password for your account. This link is only for you and should not be shared.

      .email-actions
        a.email-btn(href=`${process.env.CANONICAL_URL}set-new-password-page/${url}`) Reset Password

      .details-box
        .detail-row
          .detail-label Request
          .detail-value Password reset

        .detail-row
          .detail-label Account
          .detail-value #{firstname}

      .message-box
        h2 Didn't request this?
        p If you did not request a password reset, you can safely ignore this email. Your password will not change unless you use the reset link.

      .email-footer
        p Ang Hiyas QLD, Australia
        p This email was sent because a password reset was requested for an Ang Hiyas account.