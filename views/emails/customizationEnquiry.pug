extends baseEmail

block content

	header
		.orderConfirm_header--img
			img(src=logoUrl, alt="company-logo")

	main.container
		.email_enquiry
			p Name: #{enquiry.name}
			p Email: #{enquiry.email}
			p Phone: #{enquiry.phone}
			p Outfit: #{enquiry.outfit}
			p Event: #{enquiry.event}
			p Message: #{enquiry.message}
			p Preferred Contact: #{enquiry.preferredContactMethod}