extends baseEmail

block content

  main.email-wrapper

    .email-card

      .email-header
        img.email-logo(src=logoUrl, alt="Ang Hiyas logo")
        h1 Welcome to Ang Hiyas
        p.email-subtitle Your account has been created successfully.

      .message-box
        p Hi #{firstname},
        p Welcome to Ang Hiyas. You can now save your details, manage your account, and explore Barong Tagalog, Filipiniana, accessories and custom services.

      .email-actions
        a.email-btn(href=`${url}`) View My Account

      .details-box
        .detail-row
          .detail-label Account
          .detail-value Active

        .detail-row
          .detail-label Website
          .detail-value
            a.detail-link(href="https://www.anghiyas.com.au") www.anghiyas.com.au

      .message-box
        h2 Need help?
        p If you have questions about sizing, custom orders, rentals or availability, you can contact Ang Hiyas through the website.

      .email-footer
        p Ang Hiyas QLD, Australia
        p This email was sent because an Ang Hiyas account was created using this email address.