extends baseEmail

block content

  main.email-wrapper

    .email-card

      .email-header
        img.email-logo(src=logoUrl, alt="Ang Hiyas logo")
        h1 Password updated
        p.email-subtitle Your Ang Hiyas account details were recently changed.

      .message-box
        p Hi #{firstname},
        p This is a quick confirmation that your Ang Hiyas account password was updated successfully.

      .details-box
        .detail-row
          .detail-label Update Password
          .detail-value Account details changed

        .detail-row
          .detail-label Account
          .detail-value #{firstname}

      .message-box
        h2 Wasn't this you?
        p If you did not make this change, please reset your password and contact Ang Hiyas as soon as possible.

      .email-footer
        p Ang Hiyas QLD, Australia
        p This email was sent because changes were made to your Ang Hiyas account.