extends base 



block content

	main
	
		section.rentalsPage
			.container
			
				.salesPage__grid
				
					.salesPage__grid--image--box
					
						.salesPage__grid--image
							img(src="/img/other_imgs/side-img-5.jpeg", class='salesPage--img', alt="")
		
					.rentalsPage--heading-box

						h1.rentalsPage--heading Rentals
						p.rentalsPage__tagline Look elegant without the commitment
						p.rentalsPage__text Rent our beautifully crafted Filipiniana and Barong for your next special occasion.
						p.rentalsPage__text Perfect for weddings, formal events, and cultural celebrations. 
						
						
						p.rentalsPage__text Style, tradition, and convenience - all in one. 
						
						ul.rentalsPage__benefits
							li.rentalsPage__benefit
								img(src="/img/icons/check-gold.svg", alt="")
								p Stylish designs
							li.rentalsPage__benefit
								img(src="/img/icons/check-gold.svg", alt="")
								p Various sizes
							li.rentalsPage__benefit
								img(src="/img/icons/check-gold.svg", alt="")
								p Affordable rates
						
						p.rentalsPage__text Look your best without spending a fortune.
						
						
						p.rentalsPage__text We recommend booking early to secure your preferred design and size. Reserve yours today
							
						.rentalsPage__actions
							a.rentalsPage__cta(href='/static/contact') Rental Enquiry
							a.rentalsPage__cta(href='/static/rental-guidelines') Rental Guidelines
							