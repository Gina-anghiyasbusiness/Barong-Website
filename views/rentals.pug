extends base 



block content

	main
	
		section.rentalsPage
			.container
			
				.salesPage__grid
				
					.salesPage__grid--image--box
					
						.salesPage__grid--image
							img(src="/img/other_imgs/side-img-5.jpeg", class='salesPage--img', loading="eager", fetchpriority="high", decoding="async" , alt="Barong Tagalog and Filipiniana rentals")
		
					.rentalsPage--heading-box

						h1.rentalsPage--heading Barong Tagalog & Filipiniana Rentals
						p.rentalsPage__tagline Elegant Filipino formalwear hire for weddings, events, and cultural occasions.
						
						p.rentalsPage__text Rent beautifully crafted Barong Tagalog and Filipiniana outfits for weddings, graduations, oath-taking ceremonies, cultural celebrations, and formal events.
						p.rentalsPage__text Available through Ang Hiyas in Logan near Brisbane, our rental options make it easier to wear traditional Filipino clothing without buying outright. 
												
						p.rentalsPage__text Style, tradition, and convenience — all in one.
						
						ul.rentalsPage__benefits
							li.rentalsPage__benefit
								img(src="/img/icons/check-gold.svg", alt="")
								p Barong Tagalog and Filipiniana rental options

							li.rentalsPage__benefit
								img(src="/img/icons/check-gold.svg", alt="")
								p Styles for weddings and formal events

							li.rentalsPage__benefit
								img(src="/img/icons/check-gold.svg", alt="")
								p Various sizes and elegant designs

							li.rentalsPage__benefit
								img(src="/img/icons/check-gold.svg", alt="")
								p Affordable Filipino formalwear hire
						
						p.rentalsPage__text  Look your best for your special occasion without purchasing a full outfit.
						
						
						p.rentalsPage__text We recommend booking early to secure your preferred Barong Tagalog or Filipiniana design, size, and rental date.
							
						.rentalsPage__actions
							a.rentalsPage__cta(href='/static/contact') Rental Enquiry
							a.rentalsPage__cta(href='/static/rental-guidelines') Rental Guidelines
							