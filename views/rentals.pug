extends base 



block content

	main
	
		section.rentalsPage
			.container
			
				.salesPage__grid
				
					.salesPage__grid--image--box
					
						.salesPage__grid--image
							img(src="/img/other_imgs/side-img-5.webp", class='salesPage--img', loading="eager", fetchpriority="high", decoding="async" , alt="Barong Tagalog and Filipiniana rentals")
		
					.rentalsPage--heading-box

						h1.rentalsPage--heading Barong Tagalog & Filipiniana Rentals
						p.rentalsPage__tagline Elegant Filipino formalwear hire for weddings, events, and cultural occasions.
						
						p.rentalsPage__text Rent beautifully crafted Barong Tagalog and Filipiniana outfits for weddings, graduations, oath-taking ceremonies, cultural celebrations, and formal events.
						p.rentalsPage__text Located near Brisbane, Ang Hiyas offers Barong Tagalog rental and Filipiniana rental options for weddings, formal events and cultural occasions across Queensland and Australia.
												
						p.rentalsPage__text Style, tradition, and convenience — all in one.
						
						ul.rentalsPage__benefits
							li.rentalsPage__benefit
								img(src="/img/icons/check-gold.svg", alt="")
								p Barong Tagalog rental for weddings and formal events

							li.rentalsPage__benefit
								img(src="/img/icons/check-gold.svg", alt="")
								p Filipiniana rental for cultural celebrations

							li.rentalsPage__benefit
								img(src="/img/icons/check-gold.svg", alt="")
								p Filipino formalwear hire near Brisbane

							li.rentalsPage__benefit
								img(src="/img/icons/check-gold.svg", alt="")
								p Various sizes and elegant designs
						
						p.rentalsPage__text Enjoy traditional Filipino formalwear for your special occasion without purchasing a full outfit.
						
						p.rentalsPage__text We recommend booking early to secure your preferred Barong Tagalog or Filipiniana outfit, size and rental date.
							
						.rentalsPage__actions
							a.rentalsPage__cta(href='/static/contact') Enquire About Rentals
							a.rentalsPage__cta(href='/static/rental-guidelines') Rental Guidelines
							