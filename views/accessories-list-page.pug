extends base

include ../mixins/_breadcrumbs


block content 

	main.homePage__main.container
	
		section.homePage-productList
		
			.productList--heading-box
				.productList__intro
					p.productList__eyebrow Accessories & Giftware
					h1.productList--sub-heading Accessories
					p.productList__intro-text Explore accessories and selected Filipino-inspired pieces for gifting, cultural celebrations, weddings, special occasions, and everyday use.
							
				.productList_sort-box

					+breadcrumbs(breadcrumbs)
					form#form-product-sort.product-sort-form(action="/accessories-list" method="GET") 						
						input(type='hidden' name='color' value=selectedColor || '')
						input(type='hidden' name='category' value=selectedcategory || '')
					
						.product-sort--row
							label(for="productSort") Sort:
							select#productSort(name="productSort") 
								option(value="newest" selected=selectedOption === 'newest') Newest 
								option(value="lowest" selected=selectedOption === 'lowest') Lowest Price 
								option(value="highest" selected=selectedOption === 'highest') Highest Price 
								option(value="alphabet" selected=selectedOption === 'alphabet') A-Z		
			
			.main_barong-list

				.barong-list__filter

					.barong-list__filter-clear 
						a.barong-list__clear-filters(href='/accessories-list') Clear Filters

					.barong-list__filter-color
						.barong-list__filter--btn-box
							button#bag__filter-btn--color.barong-list__filter-btn(type='button') Color
						ul#bag-list--ul-color.barong-list--ul-color
							each color in colorList
								li
									a(
										href=`?productSort=${selectedOption || 'newest'}&color=${color}&category=${selectedcategory || ''}`
										class=selectedColor === color ? 'active' : ''
									) #{color.charAt(0).toUpperCase() + color.slice(1)}

					.barong-list__filter-category
						.barong-list__filter--btn-box
							button#bag__filter-btn--category.barong-list__filter-btn(type='button') Collection
						ul#bag-list--ul-category.barong-list--ul-category
							each category in categoryList
								li
									a(
										href=`?productSort=${selectedOption || 'newest'}&color=${selectedColor || ''}&category=${category._id}`
										class=selectedcategory === String(category._id) ? 'active' : ''
									)= category.name
									
		
				.productList 		
				
					each product,i in productlist
						.productList__product 	
							a(href=`/accessories/${product.slug}` class='productList__page--link') 
								- const category = 	product.category ? product.category.name : "";
								.productList-box--img 
									
									img(src=`/img/product_imgs/${product.imageCover}`, alt=`${product.name}`,width="800",height="450",  class='accsListPage__img' , loading=i < 4 ? "eager" : "lazy" , fetchpriority=i === 0 ? "high" : "auto" )
									
								.productList-box
									.productList-box--heading
										h3 #{product.name}
									.productList__group--box.muted-text
										if product.discountPrice && product.discountPrice < product.originalPrice
											p.price--old $#{product.originalPrice}
											p.price--new $#{product.discountPrice}
										else 
											p.price--single $#{product.originalPrice}