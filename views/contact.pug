extends base 

block content

	main.container
	
		section.contactPage
		
			.contactPage__cards--box 
			
				a.contactPage__card.contactPage__card--link(href="tel:+61403542521")
					.contactPage__card-icon
						img(src="/img/icons/phone.svg", alt="")
					.contactPage__card-heading
						p Call/SMS
					.contactPage__card-details.contactPage__card-details-center
						p +61403542521					
					
				a.contactPage__card.contactPage__card--link( href="mailto:info@anghiyas.com.au?subject=Enquiry%20from%20Ang%20Hiyas&body=Hi%20Nyck%2C%0A%0AI'm%20enquiring%20about%3A%0A%0A")
					.contactPage__card-icon
						img(src="/img/icons/envelope.svg", alt="")
					.contactPage__card-heading
						p Email
					.contactPage__card-details.contactPage__card-details-center
						p info@anghiyas.com.au
					
				a.contactPage__card.contactPage__card--link(href="https://www.google.com/maps/search/?api=1&query=Queensland%2C+Australia" target="_blank" rel="noopener")
				
					.contactPage__card-icon
						img(src="/img/icons/map-pin.svg", alt="")
					.contactPage__card-heading
						p Location & Service
					.contactPage__card-details.contactPage__card-details-center.contact__card--flex
						p Based Near Brisbane
						p Serving Queensland
						p & Australia-wide
	
						
				.contactPage__card
					.contactPage__card-icon
						img(src="/img/icons/clock.svg", alt="")
					.contactPage__card-heading
						p Hours / Appointments
					.contactPage__card-details.contactPage__card-details-center.contact__card--flex
						p Monday - Friday : 9-5
						p Saturday 10-4
						p Sunday 1-4					
					
			
			section.contactPage__form-section 
					
				.contactPage__grid
				
					.contactPage__textbox
					
						.contactPage__form-heading
						
							//- h1 Get in Touch
							h1 Contact Ang Hiyas
							
						.contactPage__form-text
							h2 We'd love to hear from you! 
							p Have a question about Barong Tagalog, Filipiniana, custom tailoring, rentals, ready-made Filipino formalwear, or wedding attire? 
							p Send us a message and we’ll get back to you as soon as possible.
						
						
					.contactPage__form
					
							
							form(action="/api/v1/enquiries" method='POST' class='contactPage__form-box')
								.contactPage__form-row 
									label(for="name") Name
									input(type="text" name='name' id='name' required)
								.contactPage__form-row 
									label(for="email") Email
									input(type="email" name='email' id='email' required)
								.contactPage__form-row 
									label(for="phone") Phone (optional)
									input(type="tel" name='phone' id='phone')
								.contactPage__form-row 
									label(for="enquiry") Enquiry Type
									select(name="enquiry" id='enquiry' required)
										option(value="General Enquiry") General Enquiry
										option(value="Custom Barong & Filipiniana") Custom Barong & Filipiniana
										option(value="Rentals") Rentals
										option(value="Product / Sales Enquiry") Product / Sales Enquiry
										option(value="Wedding or Event Enquiry") Wedding or Event Enquiry
									
								.contactPage__form-row-method
									label.contactPage__method-label Preferred Contact Method

								.contactPage__form-method
									.contactPage__contact-methods
										label(for="contact-call") Call
										input(type="radio" name="preferredContactMethod" value="call" id="contact-call")

									.contactPage__contact-methods
										label(for="contact-text") Text
										input(type="radio" name="preferredContactMethod" value="text" id="contact-text")

									.contactPage__contact-methods
										label(for="contact-email") Email
										input(type="radio" name="preferredContactMethod" value="email" id="contact-email")
																	
								.contactPage__form-row 
									label(for="message"  class='enquiry-label') Additional Information
									textarea(name="message" rows='3', cols="42", id='message' placeholder='Tell us what you’re looking for, your event date, sizing needs, or any questions.')
									
								.contactPage__form-row.contactPage__honeypot(aria-hidden="true")
									label(for="website") Website
									input(type="text" name="website" id="website" tabindex="-1" autocomplete="off")
									
								.contactPage--btn-box
									button(type='submit' class='submit_form--button') Submit Enquiry