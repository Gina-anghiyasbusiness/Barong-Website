extends base 

block content

	main.container
	
		section.contactPage
		
			.contactPage__cards--box 
			
				a.contactPage__card.contactPage__card--link(href="tel:+61417273787")
					.contactPage__card-icon
						img(src="/img/icons/phone.svg", alt="")
					.contactPage__card-heading
						h4 Call/SMS
					.contactPage__card-details.contactPage__card-details-center
						p +61 403542521						
					
				a.contactPage__card.contactPage__card--link( href="mailto:nyck_knox@yahoo.com?subject=Enquiry%20from%20Ang%20Hiyas&body=Hi%20Nyck%2C%0A%0AI'm%20enquiring%20about%3A%0A%0A")
					.contactPage__card-icon
						img(src="/img/icons/envelope.svg", alt="")
					.contactPage__card-heading
						h4 Email
					.contactPage__card-details.contactPage__card-details-center
						p nageescloset2024@gmail.com 
					
				a.contactPage__card.contactPage__card--link(href="https://www.google.com/maps/search/?api=1&query=Queensland%2C+Australia" target="_blank" rel="noopener")
				
					.contactPage__card-icon
						img(src="/img/icons/map-pin.svg", alt="")
					.contactPage__card-heading
						h4 Service Area
					.contactPage__card-details.contactPage__card-details-center
						p Queensland
						
				.contactPage__card
					.contactPage__card-icon
						img(src="/img/icons/clock.svg", alt="")
					.contactPage__card-heading
						h4 Hours / Appointments
					.contactPage__card-details
						p Monday - Friday : 9-5
						p Saturday 10-4
						p Sunday 1-4					
					
			
			section.contactPage__form-section 
					
				.contactPage__form
				
					.contactPage__form-heading
						h2 Send an Enquiry
						
						form(action="/api/v1/enquiries" method='POST' class='contactPage__form-box')
							.contactPage__form-row 
								label(for="name") Name
								input(type="text" name='name' id='name' required)
							.contactPage__form-row 
								label(for="phone") Phone
								input(type="tel" name='phone' id='phone')
							.contactPage__form-row 
								label(for="email") Email
								input(type="email" name='email' id='email' required)
							.contactPage__form-row 
								label(for="enquiry") Enquiry Type
								select(name="enquiry" id='enquiry' required)
									option(value="" disabled selected) Select enquiry type
									option(value="customTailoring") Custom Tailoring
									option(value="rentals") Rentals
									option(value="sales") Product / Sales Enquiry
									option(value="general") General Enquiry
								
							.contactPage__form-row-method
								p Preferred Contact Method
									.contactPage__form-method

										.contactPage__contact-methods
											label Call
											input(type="radio" name="preferredContactMethod" value="call")

										.contactPage__contact-methods
											label Text
											input(type="radio" name="preferredContactMethod" value="text")

										.contactPage__contact-methods
											label Email
											input(type="radio" name="preferredContactMethod" value="email")
									
							.contactPage__form-row 
								label(for="message"  class='enquiry-label') Additional Requests
								textarea(name="message" rows='4', cols="42", id='message' placeholder='Add any Additional Requests here')
							.contactPage--btn-box
								button(type='submit' class='submit_form--button') Submit Enquiry