
extends base

block content 

	main.homePage__main#top
	
		section.homePage__hero.homePage__heading-box
		
			.homePage__hero--box.container
			
				.homePage__hero-flex
		
					h1.homePage--heading Celebrating Filipino Heritage Through Fashion
					p.homePage--sub-heading Your one-stop shop for Barong Tagalog, Filipiniana, custom tailoring, and rentals.

					.hero__cta-box
						a(href="/static/custom" class='homePage__hero-cta') Custom Barong & Filipiniana
						a(href="/static/sales" class='homePage__hero-cta') Ready-Made Filipino Clothing
						a(href="/static/rentals" class='homePage__hero-cta') Barong & Filipiniana Rentals
					

										
		//- hr.section-divider
		
		section.homePage-productList
		
			h2.homePage--sub-heading.homePage--sub-heading-home.mrgbtm--xlg.container  New Arrivals
			
			.productList.productList--home 		
			
				each product,i in products
					.productList__product 	
						a(href=`/barong/${product.slug}` class='productList__page--link') 
							- const category = 	product.category ? product.category.name : "";
							.productList-box--img 
								
								img(src=`/img/product_imgs/${product.imageCover}`, alt=`${product.name}`,width="800",height="450", class='productListPage__img' , loading=i < 4 ? "eager" : "lazy" , fetchpriority=i === 0 ? "high" : "auto" )
							.productList-box
								.productList-box--heading
									h4 #{product.name}
								.productList__group--box.muted-text
									if product.discountPrice && product.discountPrice < product.originalPrice
										p.price--old $#{product.originalPrice}
										p.price--new $#{product.discountPrice}
									else 
										p.price--single $#{product.originalPrice}

		hr.section-divider--middle
		
		section.homePage-services
			h2.homePage--sub-heading.homePage--sub-heading-home.mrgbtm--xlg.container   Why Choose Us
			
			.homePage__services--grid 
			
				a.home-services--link(href="/static/custom") 
					.homePage__services--grid-box 
						.services--icon-box
							img(src="/img/icons/ruler.svg", class='services-icon' alt='')
						.services--heading-box
							h3 Made-to-Measure
						.services--text-box
							p Custom-made Barong Tagalog and Filipiniana tailored for weddings, formal events, and cultural occasions.
						
				a.home-services--link(href="/static/custom") 
					.homePage__services--grid-box 
						.services--icon-box
							img(src="/img/icons/needle.svg", class='services-icon' alt='')
						.services--heading-box
							h3 Quality Craftsmanship
						.services--text-box
							p Premium fabrics, traditional embroidery, and Filipino craftsmanship with refined modern finishing.
				
				a.home-services--link(href="/static/custom") 
					.homePage__services--grid-box 
						.services--icon-box
							img(src="/img/icons/list-checks.svg", class='services-icon' alt='')
						.services--heading-box
							h3 Clear Process & Timelines
						.services--text-box
							p Straightforward ordering, clear timelines, and guided support for custom orders, rentals, sizing, and availability.
				
		hr.section-divider
		
		section.watermark-btm--bg 
					
			section.homePage-how-it-works.container
			
				h2.homePage--sub-heading  How Custom Orders Work
				
				.homePage-how-it-works--grid
					.how-it-works--box
						.how-it-works--box-heading
							h4 01
						.how-it-works--box-sub-heading
							p Consultation
						.how-it-works--box-p 
							p Tell us about your Barong Tagalog, Filipiniana, wedding attire, or other Filipino formalwear needs, including your event date, style preferences, and location.				
					.how-it-works--box
						.how-it-works--box-heading
							h4 02 
						.how-it-works--box-sub-heading
							p Measurements & Design
						.how-it-works--box-p 
							p We guide you through measurements, fabric choices, embroidery details, and made-to-measure design options for your custom outfit.					
					.how-it-works--box
						.how-it-works--box-heading
							h4 03 
						.how-it-works--box-sub-heading
							p Crafting & Delivery
						.how-it-works--box-p 
							p Your custom Barong Tagalog or Filipiniana is crafted with traditional detail and prepared for weddings, cultural celebrations, graduations, and formal events.	

			//- section.homePage-shoe-collection 
			//- 	.homePage-shoe-collection-container
			//- 		.homePage-shoe-collection-text-box
			//- 			h2.shoe_heading-dark  Footwear Collection
			//- 			p Explore our selection of Filipino footwear and accessories.
