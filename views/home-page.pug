			//- 				img(src="/img/product_imgs/shoes/shoes-1.png", class='shoe_collection-shoe ' alt="")
			//- 			.homePage-shoe-collection-image.shoes-2
			//- 				img(src="/img/product_imgs/shoes/shoes-2.png", class='shoe_collection-shoe ' alt="")
			//- 			.homePage-shoe-collection-image.shoes-3
			//- 				img(src="/img/product_imgs/shoes/shoes-3.png", class='shoe_collection-shoe ' alt="")
						
			
			section.homePage-contact--cta.container
			
				.homePage-contact--cta
					.cta-heading
						h2.homePage--sub-heading Ready to start your custom Barong Tagalog or Filipiniana?
					.cta-text
						p Get in touch to discuss custom tailoring, measurements, rentals, and availability.
						p.cta-text-p Based near Brisbane and serving customers across Queensland and Australia.
						
					.hero__cta-box
						a(href="/static/contact-custom" class='homePage__hero-cta homePage_contact-cta') Start Custom Enquiry
				
						
		
				
			
			
	
	
