			section.homePage-contact--cta.container
			
				.homePage-contact--cta
					.cta-heading
						h2.homePage--sub-heading Ready to start your Custom Barong or Filipiniana?
					p Get in touch to discuss tailoring, measurements, and availability.
						
						.hero__cta-box
							a(href="/static/contact-custom" class='homePage__hero-cta homePage_contact-cta') Enquire Now
				
						
		
				
			
			
	
	