extends base 



block content

	main
	
		section.salesPage
			.container
			
				.salesPage__grid
				
					.salesPage__grid--image--box
					
						.salesPage__grid--image
							img(src="/img/other_imgs/side-img-2.webp", class='salesPage--img', loading="eager", fetchpriority="high", decoding="async", alt="Ready-made Barong Tagalog and Filipiniana formalwear from Ang Hiyas")
						
		
					.salesPage__grid--text--box
		
						.salesPage--heading-box

							h1.salesPage--heading Ready-Made Barong Tagalog & Filipiniana
