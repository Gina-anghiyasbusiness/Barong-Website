extends base 



block content

	main
	
		section.salesPage
			.container
			
				.salesPage__grid
				
					.salesPage__grid--image--box
					
						.salesPage__grid--image
							img(src="/img/other_imgs/side-img-2.jpeg", class='salesPage--img', alt="")
						
		
					.salesPage__grid--text--box
		
						.salesPage--heading-box

							h1.salesPage--heading Ready-Made Barong & Filipiniana
							p.salesPage__tagline Timeless Elegance, Ready When You Are
							p.salesPage__text Discover our collection of ready-made Barong and Filipiniana—crafted with tradition and designed for modern style. Perfect for weddings, formal events, and special occasions.
							p.salesPage__text Walk in, try on, and take home. No waiting, no hassle. Just style.
							
							ul.salesPage__benefits
								li.salesPage__benefit Various sizes available
								li.salesPage__benefit High quality fabrics
								li.salesPage__benefit Stylish modern designs
								li.salesPage__benefit Look elegant without the wait
								
							.salesPage__actions
								a.salesPage__cta(href='/barong-list') Shop Ready-Made Styles
						