extends be_base 

block content 

	main.admin-enquiryList.wide-container 
	
		h2.admin__page--heading Customization Enquiry List
		
		section.admin-customEnquiryList--grid
		
			.admin-customEnquiryList__headings 
		
				p.admin-productList_head Name
				p.admin-productList_head Email
				p.admin-productList_head Outfit
				p.admin-productList_head Event
		
				p.admin-productList_head Date
				p.admin-productList_head Status
				p.admin-productList_head Details
			
			.admin-customEnquiryList__loop 
				each enquiry in customEnquiryList 
					- const created = new Date(enquiry.createdAt).toLocaleDateString('en-GB');
					p #{enquiry.name} 
					p #{enquiry.email} 
					p #{enquiry.outfit} 
					p #{enquiry.event} 
	
					p #{created} 
					p #{enquiry.status} 
					a(href=`/admin/be_custom-enquiries/${enquiry.id}`) ➡️